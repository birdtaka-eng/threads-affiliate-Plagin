{
    "manifest_version": 3,
    "name": "Threads職人 Pro",
    "version": "5.6",
    "description": "あらゆるサイトから画像を手動選択できる最新の投稿支援ツール",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Threads職人を開く"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "content.js",
                "instagram.js",
                "rakuten.js"
            ]
        }
    ]
}